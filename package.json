{
  "name": "pr-lens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "REACT_EDITOR=none next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "eval:collect": "tsx eval/collect.ts",
    "eval:run": "tsx eval/run.ts",
    "eval:report": "tsx eval/report.ts",
    "simulate:incremental": "tsx scripts/simulate-incremental.ts",
    "app": "next build && next start -H 127.0.0.1"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
